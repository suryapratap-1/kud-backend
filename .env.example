# Copy to .env and fill in. Never commit .env.
# Required: API_URL, FRONTEND_URL, DATABASE_URL, BETTER_AUTH_SECRET. Everything else can stay empty;
# Google login, file storage, the spam check and billing switch themselves off until they're filled in.

PORT=4000

# Where browsers reach this API, and where the Next.js frontend runs. Only FRONTEND_URL may call the
# API with the login cookie. In production: https://api.kudos.com and https://app.kudos.com
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Production only: the parent domain both apps share, so pages rendered by the frontend server can use
# the login cookie. Example: .kudos.com  Leave empty locally (localhost:3000 and :4000 already share it).
COOKIE_DOMAIN=

# Database. Local Postgres from docker-compose: postgres://kudos:kudos@localhost:5434/kudos
# Production: Neon (pooled connection string) or Supabase ("Transaction pooler" string, port 6543).
DATABASE_URL=

# Session signing secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Visitor IPs for rate limiting. TRUST_PROXY = how many proxies sit in front of the API
# (0 when exposed directly, 1 behind one load balancer or Nginx).
TRUST_PROXY=0
# Or a header your host overwrites with the real IP. Cloudflare: cf-connecting-ip · Fly.io: fly-client-ip
CLIENT_IP_HEADER=

# Google login. Create an OAuth client in Google Cloud Console.
# Authorized redirect URI: <API_URL>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Defaults point at Mailpit from docker-compose (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kudos <hello@kudos.local>"

# File storage for review videos and photos. Leave empty to store files in .storage/ locally.
# Cloudflare R2: create a bucket, enable its public URL (or a custom domain), and an API token with Object Read & Write.
# Endpoint looks like https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public URL looks like https://pub-xxxx.r2.dev, or a custom domain.
# Use a separate domain (e.g. kudos-media.com), not a subdomain of the app, so user uploads never share the app's origin.
STORAGE_PUBLIC_URL=

# Cloudflare Turnstile secret (spam check on the public review form). The site key goes in the frontend.
# Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Razorpay test mode. Dashboard → Settings → API Keys (test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: <API_URL>/webhooks/razorpay with subscription.* events.
RAZORPAY_WEBHOOK_SECRET=
# Run `pnpm billing:setup` after adding the keys above; it creates the Pro plans and prints both ids.
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_ID_YEARLY=

# Development only. `pnpm db:seed` creates a demo account whose password is in this repository,
# so it refuses to run on anything but a local database. Set to true only for a throwaway staging database.
ALLOW_DEMO_SEED=
